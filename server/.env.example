# API port (the web app runs on 4010). The baseline POC uses 4000/4001, so both can run side by side.
PORT=4011
CORS_ORIGINS=http://localhost:4010

# Its own Postgres database (Mastra keeps its tables in schema "mastra"), so it doesn't touch the baseline's workflows_poc.
# npm run db:setup creates the database if it is missing.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/workflow_poc_agentic

# Waits, shortened for demos (seconds)
REMIND_AFTER_SEC=120
EXPIRE_AFTER_SEC=600
APPROVAL_TIMEOUT_SEC=1800

# viaSocket Apps API (same org/project as ticket0-b). The POC is its own end user.
VIASOCKET_ORG_ID=
VIASOCKET_PROJECT_ID=
VIASOCKET_EMBED_SECRET=
# Own viaSocket end user by default; set workflows-poc to reuse the baseline POC's tools.
VIASOCKET_UID=workflow-poc-agentic

# Agents (Mastra): the model every agent call uses. Not needed to boot; needed to answer chats.
# LLM_PROVIDER: openai | anthropic | openai-compatible (then LLM_BASE_URL, e.g. a GTWY pass-through endpoint later)
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# 1 = enable /dev/* routes (start a test agent run, call wf_* tools by hand). Leave unset in deployed envs.
DEV_ENDPOINTS=1
